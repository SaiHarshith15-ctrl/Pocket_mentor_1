# ============================================
# POCKET MENTOR - ENVIRONMENT VARIABLES
# Copy this file to server/.env and fill in real values.
# NEVER commit the real .env file.
# ============================================

# Port the Express server runs on
PORT=5000

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/pocket-mentor
# Atlas:  mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/pocket-mentor
MONGODB_URI=mongodb://127.0.0.1:27017/pocket-mentor

# Secret used to sign JWT tokens. Use a long random string in real deployments.
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# When true, all AI calls return realistic sample/mock data instead of
# calling the real Gemini API. Use this for demos/dev to avoid burning quota.
USE_MOCK_AI=true

# URL of the frontend, used for CORS
CLIENT_URL=http://localhost:5173

# Mastery threshold (0-100) at which a topic is considered "mastered"
MASTERY_THRESHOLD=80
